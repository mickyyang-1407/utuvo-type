    <string name="feel_haptic">按键振动</string>
    <string name="feel_strength_off">关</string>
    <string name="feel_strength_light">轻</string>
    <string name="feel_strength_medium">中</string>
    <string name="feel_strength_strong">强</string>
    <string name="feel_sound">按键声音</string>
    <string name="feel_explain">按下去的当下就会振动（不是松开才震），选字、切换键盘也一样。手机静音或系统关闭了触觉反馈时都不会有。按键声音是另外一个开关。</string>
    <string name="tab_dictate">听写</string>
    <string name="tab_history">历史</string>
    <string name="tab_settings">设置</string>
    <string name="hant_input_title">“繁”键盘输入法</string>
    <string name="hant_input_zhuyin">注音</string>
    <string name="hant_input_pinyin">拼音</string>
    <string name="hant_input_explain">“繁”用注音还是拼音；键盘上按“繁”就会用这个。键盘里也能直接切换。</string>
    <string name="guide_title">使用说明</string>
    <string name="guide_intro">照着下面做一次，之后点光球就能说话。</string>
    <string name="guide_setup_header">首次设置（只需做一次）</string>
    <string name="guide_setup_1">添加键盘</string>
    <string name="guide_setup_1_detail">设置 → 系统 → 语言和输入法 → 键盘 → 添加键盘 → UTUVO Type。</string>
    <string name="guide_setup_2">允许麦克风</string>
    <string name="guide_setup_2_detail">打开一次 UTUVO Type App，系统询问麦克风时点击“允许”。没有麦克风，键盘听不到你说话。</string>
    <string name="guide_setup_3">启用并切换</string>
    <string name="guide_setup_3_detail">在键盘设置里打开 UTUVO Type，之后在任何 App 点击输入框、从键盘图标切换到它。</string>
    <string name="guide_open_settings">打开键盘设置</string>
    <string name="guide_use_header">每次用键盘说话</string>
    <string name="guide_use_1">点光球开始说话</string>
    <string name="guide_use_1_detail">光球在键盘正中间。点一下开始录音。</string>
    <string name="guide_use_2">再点一下光球完成</string>
    <string name="guide_use_2_detail">说完再点一次，文字就会出现在光标处。</string>
    <string name="guide_use_3">发送出去</string>
    <string name="guide_use_3_detail">右边的“发送”会把整句粘贴；不发送也可以自己在 App 里编辑。</string>
    <string name="guide_use_note">不用再设置一次：麦克风权限与键盘启用都做好之后，随时点光球就能说话。</string>
    <string name="guide_gesture_header">键盘上会用到的手势</string>
    <string name="guide_gesture_1">长按光球＝翻译</string>
    <string name="guide_gesture_1_detail">按住光球会出现语言弧，滑到想翻译的语言松开，接下来讲的话会翻译成那个语言。</string>
    <string name="guide_gesture_2">左右滑＝切换 EN／繁／简</string>
    <string name="guide_gesture_2_detail">在键盘上往左或往右滑，就切换到下一个语言层。也可以直接点左边的 EN／繁／简。</string>
    <string name="guide_gesture_3">“繁”层用注音还是拼音</string>
    <string name="guide_gesture_3_detail">在设置页的“繁”键盘输入法可以选择注音或拼音；键盘底排的“拼／注”也能随时切换。</string>
    <string name="guide_gesture_4">长按删除键连续删除</string>
    <string name="guide_gesture_4_detail">按住不放会一直删除；按下去马上滑开则取消这一次删除。</string>
    <string name="guide_edit_1">选中文字 → 说出要怎么改</string>
    <string name="guide_edit_1_detail">先在输入框选中一段文字，光球会变成薰衣草色、提示“说出要怎么改”。点光球、讲出指示（例如“改正式一点”“后面加上咖啡”），再点一下光球，改写好的文字会直接替换那一段选中内容。改写走云端，需要在设置→智能整理填入一个 key（Groq／Gemini／百炼／自定义都可以，用哪一个看屏幕上的引擎标识）。</string>
    <string name="guide_accuracy_header">让结果更准</string>
    <string name="guide_accuracy_1">把常讲的专有名词加入个人词典</string>
    <string name="guide_accuracy_1_detail">人名、品牌、术语加入之后，粘贴时会按词典改正拼写，云端识别与智能整理也会参考这些词。</string>
    <string name="guide_accuracy_2">智能整理（默认开）</string>
    <string name="guide_accuracy_2_detail">说完先贴出识别结果，再自动删掉赘词、改口、补标点。想用云端模型就在设置页填入自己的 key。</string>
    <string name="guide_accuracy_3">云端识别（选配，需自己的 key）</string>
    <string name="guide_accuracy_3_detail">在设置页保存好 key 后打开“云端识别”，录音会用你的 key 上传识别，专有名词更准；失败会自动改用手机识别。录音会离开手机，介意的话不要打开。</string>
    <string name="guide_problem_header">遇到问题</string>
    <string name="guide_problem_1">光球点了没反应</string>
    <string name="guide_problem_1_detail">确认麦克风权限已允许、UTUVO Type 已在键盘设置里启用，而且当前使用的就是 UTUVO Type 键盘。</string>
    <string name="guide_problem_2">一直显示“整理中”、不出字</string>
    <string name="guide_problem_2_detail">打开 UTUVO Type 查看提示信息；多半是网络或 key 的问题，处理完再点一次光球。</string>
    <string name="guide_problem_3">找不到键盘／切换不到</string>
    <string name="guide_problem_3_detail">重新启用一次键盘；有时改完设置要重开 App 才会切换过去。</string>
</resources>
