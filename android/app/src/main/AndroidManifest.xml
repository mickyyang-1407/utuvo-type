<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 鍵盤自己就能錄音（Android 不像 iOS 擋鍵盤用麥克風）；權限由主 app 向使用者要。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 翻譯：下載 ML Kit 語言模型；使用者填了雲端 key 時送翻譯 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- 手機上的智慧整理用 GPU（LiteRT-LM）：沒有就退回 CPU，所以不是必要。 -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 手機上整理的模型下載完成（使用者可能已離開 App）：驗證檔案。 -->
        <receiver
            android:name=".OnDeviceDownloadReceiver"
            android:exported="true"
            android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".UTUVOImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <!-- onnxruntime-android 自帶的遙測啟動器：每次程序啟動就載入 34 MB 的 libonnxruntime.so 並建立
             Microsoft 1DS 遙測連線（1.31.0 因 JNI 不一致初始化失敗，但升版修好就會真的送）。
             0c 不需要它，「本機路徑不聯網」也不允許——拿掉。 -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>
</manifest>
