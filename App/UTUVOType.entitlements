<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  UTUVO Type entitlements（notarization 用）。
  App 未沙盒、不用 JIT／Apple Events；hardened runtime 只需宣告意圖，
  實際的麥克風／輔助使用授權由 macOS TCC 把關。

  iCloud 鍵值儲存（個人字典跟 iPhone 同步）：識別碼刻意用 iOS 版的 App ID，兩邊才是同一份。
  下面三個欄位要有 Contents/embedded.provisionprofile（Developer ID 描述檔）系統才放行，
  build-app.sh 找不到描述檔時會改用 UTUVOType-no-icloud.entitlements（只有麥克風）。
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>RPNT54P79S.com.utuvo.type</string>
	<key>com.apple.developer.team-identifier</key>
	<string>RPNT54P79S</string>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>RPNT54P79S.com.utuvo.type.ios</string>
</dict>
</plist>
