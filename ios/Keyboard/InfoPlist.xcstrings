{
  "sourceLanguage" : "zh-Hant",
  "strings" : {
    "NSMicrophoneUsageDescription" : {
      "comment" : "Info.plist 權限說明；原文在 ios/project.yml",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The UTUVO Type keyboard records only after you tap the microphone button, turning what you say into text inserted at the cursor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTUVO Type 键盘只在你按下麦克风键时录音，把语音转成文字插入光标处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTUVO Type 鍵盤只在你按下麥克風鍵時錄音，把語音轉成文字插入游標處。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Info.plist 權限說明；原文在 ios/project.yml",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The UTUVO Type keyboard uses iOS speech recognition to turn what you say into text. In the keyboard, recognition runs on Apple's servers, so your audio is sent to Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTUVO Type 键盘使用 iOS 语音识别把你的口述转成文字；键盘版使用服务器识别，音频会发送到 Apple。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTUVO Type 鍵盤使用 iOS 語音辨識把你的口述轉成文字；鍵盤版走伺服器辨識，音訊會送到 Apple。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
