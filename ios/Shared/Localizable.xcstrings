{
  "sourceLanguage" : "zh-Hant",
  "strings" : {
    "測試與診斷" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testing and diagnostics"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试与诊断"
          }
        }
      }
    },
    "這個語言的裝置端辨識不可用，請確認模型與權限；雲端模式也需要有效的辨識 key。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device recognition is unavailable for this language. Check models and permissions; cloud mode also needs a valid recognition key."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此语言的设备端识别不可用，请确认模型与权限；云端模式也需要有效的识别 key。"
          }
        }
      }
    },
    "未取得可用的辨識結果，請確認網路或裝置端模型後再試。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No usable transcript. Check your network or on-device model and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未取得可用的识别结果，请确认网络或设备端模型后重试。"
          }
        }
      }
    },
    "舊設定只允許文字整理，錄音仍留在本機。啟用後才會將錄音送到選定的辨識服務。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your previous settings allowed text polishing only. Audio stays on-device until you enable uploading to the selected recognition service."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧设置只允许文字整理，录音仍留在本机。启用后才会将录音发送到所选识别服务。"
          }
        }
      }
    },
    "啟用雲端辨識" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable cloud recognition"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用云端识别"
          }
        }
      }
    },
    "講步驟、流程或幾個重點時，整理成 1. 2. 3.；關掉就只分段。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formats spoken steps and key points as a numbered list. Turn off to use paragraphs only."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讲步骤、流程或几个重点时，整理成 1. 2. 3.；关闭则只分段。"
          }
        }
      }
    },
    "點上方管理阿里雲百鍊 key，辨識與文字整理共用同一把 key。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage your Bailian key above. Recognition and polishing share the same key."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击上方管理阿里云百炼 key，识别与文字整理共用同一把 key。"
          }
        }
      }
    },
    "使用選定的雲端辨識與整理服務；失敗時改用 Apple 裝置端辨識結果與本機整理，完成後一次貼入。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the selected cloud recognition and polishing services. On failure, falls back to Apple on-device recognition and local polishing, then inserts the result once."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用所选云端识别与整理服务；失败时改用 Apple 设备端识别结果与本机整理，完成后一次插入。"
          }
        }
      }
    },
    "改寫與翻譯遵循同一處理方式：本機不上傳；雲端優先使用選定服務，失敗再回退本機。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rewriting and translation follow the same mode: local stays on-device; cloud uses the selected service first and falls back locally on failure."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改写与翻译遵循同一处理方式：本机不上传；云端优先使用所选服务，失败再回退本机。"
          }
        }
      }
    },
    "最近交付 %lld 次、異常事件 %lld 次" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recent deliveries: %lld; diagnostic failures: %lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近交付 %lld 次、异常事件 %lld 次"
          }
        }
      }
    },
    "本機・隱私優先" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local · Privacy first"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机・隐私优先"
          }
        }
