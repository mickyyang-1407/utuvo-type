    "本機整理不可用，已保留辨識結果" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local polishing unavailable; transcript preserved"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机整理不可用，已保留识别结果"
          }
        }
      }
    },
    "本機整理可以用（%lld 毫秒）：%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local polishing works (%lld ms): %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机整理可用（%lld 毫秒）：%@"
          }
        }
      }
    },
    "本機模型" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-device model"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机模型"
          }
        }
      }
    },
    "本機模型這次沒有產生可用結果。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local model did not produce a usable result."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机模型本次未生成可用结果。"
          }
        }
      }
    },
    "本機模式不傳送錄音。雲端模式使用選定辨識服務的 key；尚未儲存時，請在上方選擇該服務儲存 key，再選回文字整理服務。失敗時保留 Apple 裝置端辨識結果。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local mode never uploads audio. Cloud mode uses the selected recognition service key. To save a missing key, select that service above, save it, then reselect your polishing service. Failure preserves the Apple on-device transcript."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机模式不发送录音。云端模式使用所选识别服务的 key；尚未保存时，请在上方选择该服务保存 key，再选回文字整理服务。失败时保留 Apple 设备端识别结果。"
          }
        }
      }
    },
    "正在整理，完成後可繼續說話" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polishing. You can speak again when it finishes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在整理，完成后可继续说话"
          }
        }
      }
    },
    "處理方式" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
