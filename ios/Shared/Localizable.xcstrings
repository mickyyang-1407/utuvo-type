      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice processing"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音处理路径"
          }
        }
      }
    },
    "輸入欄位已變更，未貼入" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input field changed; text was not inserted"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入框已变更，未插入"
          }
        }
      }
    },
    "辨識後先整理，再一次貼入。雲端失敗會回退本機完整整理；本機模型也不可用時保留辨識結果。診斷會分別記錄模型產出與文字交付。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polishes the transcript before inserting it once. Cloud failure falls back to full local polishing. If no local model is available, the transcript is preserved. Diagnostics distinguish model output from text delivery."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "识别后先整理，再一次插入。云端失败会回退本机完整整理；本机模型也不可用时保留识别结果。诊断会分别记录模型产出与文字交付。"
          }
        }
      }
    },
    "辨識與文字整理可選不同服務。辨識只使用這裡選定的服務，不會自動改用其他已儲存的 key。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognition and polishing can use different services. Recognition only uses the selected service, never another saved key automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "识别与文字整理可选不同服务。识别只使用这里所选的服务，不会自动改用其他已保存的 key。"
          }
        }
      }
    },
    "鍵盤使用 Apple 裝置端辨識，再由本機模型整理；音訊與文字不上傳。Qwen 僅供主 App 前景聽寫。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard uses Apple on-device recognition and local polishing. Audio and text stay on your device. Qwen is available only for dictation in the foreground app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘使用 Apple 设备端识别，再由本机模型整理；音频与文字不上传。Qwen 仅供主 App 前台听写。"
          }
        }
      }
    },
